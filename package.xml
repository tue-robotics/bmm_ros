<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bmm_ros</name>
  <version>0.0.0</version>
  <description>Bayesian Mixture Model (BMM) pointcloud denoising</description>

  <author email="iasonth95@gmail.com">Iason Theodorou</author>
  <maintainer email="iasonth95@gmail.com">Iason Theodorou</maintainer>

  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geolib2</depend>
  <depend>libconsole-bridge-dev</depend>

  <build_depend>eigen</build_depend>
  <build_depend>libboost-math-dev</build_depend>
  <build_depend>libpcl-all-dev</build_depend>
  <build_depend>libpcl-io</build_depend>

  <exec_depend>eigen</exec_depend>
  <exec_depend>libboost-math-dev</exec_depend>
  <exec_depend>libpcl-io</exec_depend>
  <exec_depend>rosconsole</exec_depend>

  <test_depend>catkin_lint_cmake</test_depend>

  <doc_depend>doxygen</doc_depend>

  <export>
    <rosdoc config="rosdoc.yaml" />
  </export>
</package>
